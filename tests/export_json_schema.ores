import module rpc from "../src/rpc.ores";

pub routine main(): void {
  val request = rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ]);
  val response = rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ]);
  let contracts_builder = rpc.builder();
  contracts_builder.add_message(request).unwrap();
  contracts_builder.add_message(response).unwrap();
  contracts_builder.add_rpc_as_http(
    rpc.rpc_method(42, "Users", "GetUser", "users.get", "GetUserRequest", "User"),
    "GET", "/users/{id}", 1001, 7
  ).unwrap();
  contracts_builder.add_http_field_binding(
    rpc.http_path_field(42, "id", "id")
  ).unwrap();
  val contracts = contracts_builder.build().unwrap();
  val generated = rpc.generate_all_checked(
    rt borrow contracts, "https://example.test/schema/rpc", "example.api", "Example.Api"
  ).unwrap();
  val document = generated.json_schema;
  for (let int index = 0; index < document.part_count(); index = index + 1) {
    stdio.out.write(document.part_at(index));
  }
  return;
}
