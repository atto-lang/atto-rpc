import module rpc from "../src/rpc.ores";

fnc ok(Result<bool, String> result): void {
  stdio.println(result.is_ok());
  return;
}

pub routine main(): void {
  val GetUserRequest = rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ]);

  val User = rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ]);

  let contracts_builder = rpc.builder();
  ok(contracts_builder.add_message(GetUserRequest));
  ok(contracts_builder.add_message(User));

  val get_user = rpc.rpc_method(
    42,
    "Users",
    "GetUser",
    "users.get",
    "GetUserRequest",
    "User"
  );

  ok(contracts_builder.add_rpc_as_http(
    get_user,
    "GET",
    "/users/{id}",
    1001,
    7
  ));
  contracts_builder.add_http_field_binding(
    rpc.http_path_field(42, "id", "id")
  ).unwrap();

  val built = contracts_builder.build();
  stdio.println(built.is_ok());

  val contracts = built.unwrap();
  stdio.println(contracts.message_count());
  stdio.println(contracts.method_count());
  stdio.println(contracts.http_handler_count());

  val http = contracts.http_by_contract(42).unwrap();
  stdio.println(http.method);
  stdio.println(http.path_template);
  stdio.println(http.handler_id);
  stdio.println(http.pipeline_id);
  stdio.println(http.contract_id);
  stdio.println(http.operation_id);

  val round_trip_rpc = rpc.rpc_from_http(rt borrow http);
  stdio.println(round_trip_rpc.service);
  stdio.println(round_trip_rpc.name);
  stdio.println(round_trip_rpc.request_type);
  stdio.println(round_trip_rpc.response_type);

  val round_trip_http = rpc.http_from_rpc(
    rt borrow round_trip_rpc,
    "POST",
    "/rpc/users/get",
    1002,
    8
  );
  stdio.println(round_trip_http.contract_id);
  stdio.println(round_trip_http.operation_id);

  val bundle = rpc.generate_all(
    rt borrow contracts,
    "https://example.test/schema/rpc",
    "example.rpc",
    "Example.Rpc"
  );

  stdio.println(bundle.json_schema.part_at(0));
  stdio.println(bundle.protobuf.part_at(0));
  stdio.println(bundle.messagepack.part_at(0));
  stdio.println(bundle.typespec.part_at(0));

  // Assert meaningful generator fragments, not only document sizes.
  stdio.println(bundle.json_schema.has_part("  \"$defs\": {"));
  stdio.println(bundle.protobuf.has_part("service "));
  stdio.println(bundle.protobuf.has_part("GetUser"));
  stdio.println(bundle.messagepack.has_part("mpackdef 1"));
  stdio.println(bundle.typespec.has_part("@get"));
  stdio.println(bundle.typespec.has_part("  @path(\""));
  stdio.println(bundle.typespec.has_part("interface "));

  // Unsupported HTTP methods fail closed instead of producing ambiguous
  // TypeSpec transport semantics.
  stdio.println(rpc.http_handler(
    "OPTIONS",
    "/users/{id}",
    1003,
    7,
    44,
    "users.options",
    "Users",
    "OptionsUser",
    "GetUserRequest",
    "User"
  ).is_valid());

  // Streaming RPC metadata reaches the gRPC emitter without magic integers.
  let stream_builder = rpc.builder();
  ok(stream_builder.add_message(rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])));
  ok(stream_builder.add_message(rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ])));
  ok(stream_builder.add_rpc(rpc.streaming_rpc_method(
    43,
    "Users",
    "WatchUsers",
    "users.watch",
    "GetUserRequest",
    "User",
    rpc.server_stream()
  )));
  val stream_contracts = stream_builder.build().unwrap();
  stdio.println(rpc.protobuf(rt borrow stream_contracts, "example.rpc").has_part("stream "));

  // Fail closed on duplicate wire field numbers.
  val Bad = rpc.message("Bad", arr[
    rpc.field("a", 1, "1", rpc.string_type(), true, false),
    rpc.field("b", 1, "1", rpc.int32_type(), true, false)
  ]);
  stdio.println(Bad.is_valid());

  // Protobuf field numbers must stay inside the legal user range.
  stdio.println(rpc.field(
    "reserved",
    19000,
    "19000",
    rpc.string_type(),
    true,
    false
  ).is_valid());

  // Named message fields must resolve against the same contract registry.
  let named_builder = rpc.builder();
  ok(named_builder.add_message(rpc.message("Wrapper", arr[
    rpc.field("child", 1, "1", rpc.message_type("MissingChild"), true, false)
  ])));
  stdio.println(named_builder.build().is_err());

  // add_http_as_rpc is transactional: duplicate RPC identity must not leave
  // behind the HTTP half of a failed combined registration.
  let tx_http_builder = rpc.builder();
  ok(tx_http_builder.add_message(rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])));
  ok(tx_http_builder.add_message(rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ])));
  ok(tx_http_builder.add_rpc(rpc.rpc_method(
    42, "Users", "GetUser", "users.get", "GetUserRequest", "User"
  )));
  val tx_http_method = rpc.rpc_method(
    42, "Users", "GetUser", "users.get", "GetUserRequest", "User"
  );
  stdio.println(tx_http_builder.add_http_as_rpc(rpc.http_from_rpc(
    rt borrow tx_http_method,
    "POST",
    "/alias/users/get",
    2001,
    9
  )).is_err());
  stdio.println(tx_http_builder.method_count());
  stdio.println(tx_http_builder.http_handler_count());

  // add_rpc_as_http is transactional in the opposite direction too.
  let tx_rpc_builder = rpc.builder();
  ok(tx_rpc_builder.add_message(rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])));
  ok(tx_rpc_builder.add_message(rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ])));
  val tx_rpc_http_method = rpc.rpc_method(
    42, "Users", "GetUser", "users.get", "GetUserRequest", "User"
  );
  ok(tx_rpc_builder.add_http(rpc.http_from_rpc(
    rt borrow tx_rpc_http_method,
    "GET",
    "/users/{id}",
    1001,
    7
  )));
  stdio.println(tx_rpc_builder.add_rpc_as_http(
    rpc.rpc_method(42, "Users", "GetUser", "users.get", "GetUserRequest", "User"),
    "GET",
    "/users/{id}",
    1001,
    7
  ).is_err());
  stdio.println(tx_rpc_builder.method_count());
  stdio.println(tx_rpc_builder.http_handler_count());

  // IDs alone are not enough: the full HTTP/RPC identity must agree.
  let mismatch_builder = rpc.builder();
  ok(mismatch_builder.add_message(rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])));
  ok(mismatch_builder.add_message(rpc.message("User", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false),
    rpc.field("display_name", 2, "2", rpc.string_type(), true, false),
    rpc.field("tags", 3, "3", rpc.string_type(), false, true)
  ])));
  ok(mismatch_builder.add_rpc(rpc.rpc_method(
    42, "Users", "GetUser", "users.get", "GetUserRequest", "User"
  )));
  ok(mismatch_builder.add_http(rpc.http_handler(
    "GET",
    "/users/{id}",
    1001,
    7,
    42,
    "users.get",
    "WrongService",
    "GetUser",
    "GetUserRequest",
    "User"
  )));
  stdio.println(mismatch_builder.build().is_err());

  // HTTP field bindings must name real request fields.
  let unknown_binding_builder = rpc.builder();
  unknown_binding_builder.add_message(rpc.message("Req", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])).unwrap();
  unknown_binding_builder.add_message(rpc.message("Res", arr[
    rpc.field("ok", 1, "1", rpc.bool_type(), true, false)
  ])).unwrap();
  unknown_binding_builder.add_rpc_as_http(
    rpc.rpc_method(120, "Test", "UnknownField", "test.unknown", "Req", "Res"),
    "GET",
    "/unknown/{missing}",
    3001,
    1
  ).unwrap();
  unknown_binding_builder.add_http_field_binding(
    rpc.http_path_field(120, "missing", "missing")
  ).unwrap();
  stdio.println(unknown_binding_builder.build().is_err());

  // Path parameters cannot point at optional request fields.
  let optional_path_builder = rpc.builder();
  optional_path_builder.add_message(rpc.message("OptionalReq", arr[
    rpc.field("id", 1, "1", rpc.string_type(), false, false)
  ])).unwrap();
  optional_path_builder.add_message(rpc.message("OptionalRes", arr[
    rpc.field("ok", 1, "1", rpc.bool_type(), true, false)
  ])).unwrap();
  optional_path_builder.add_rpc_as_http(
    rpc.rpc_method(
      121,
      "Test",
      "OptionalPath",
      "test.optional_path",
      "OptionalReq",
      "OptionalRes"
    ),
    "GET",
    "/optional/{id}",
    3002,
    1
  ).unwrap();
  optional_path_builder.add_http_field_binding(
    rpc.http_path_field(121, "id", "id")
  ).unwrap();
  stdio.println(optional_path_builder.build().is_err());

  // Fail closed when an RPC references a message not present in the registry.
  let missing_builder = rpc.builder();
  ok(missing_builder.add_message(rpc.message("GetUserRequest", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])));
  ok(missing_builder.add_rpc(rpc.rpc_method(
    99,
    "Users",
    "Missing",
    "users.missing",
    "GetUserRequest",
    "MissingResponse"
  )));
  stdio.println(missing_builder.build().is_err());

  // Reject ambiguous external parameter names for the same HTTP contract
  // and location, without rejecting separate locations or contracts.
  let alias_builder = rpc.builder();
  alias_builder.add_http_field_binding(
    rpc.http_query_field(500, "first", "shared")
  ).unwrap();
  stdio.println(alias_builder.add_http_field_binding(
    rpc.http_query_field(500, "second", "shared")
  ).is_err());
  stdio.println(alias_builder.http_field_binding_count());

  alias_builder.add_http_field_binding(
    rpc.http_header_field(500, "third", "shared")
  ).unwrap();
  stdio.println(alias_builder.http_field_binding_count());

  alias_builder.add_http_field_binding(
    rpc.http_query_field(501, "fourth", "shared")
  ).unwrap();
  stdio.println(alias_builder.http_field_binding_count());

  // Contract names are emitted into several IDLs. Reject malformed names
  // before generation rather than allowing syntax injection or bad $refs.
  stdio.println(rpc.message_type("Bad-Name").is_valid());
  stdio.println(rpc.field(
    "bad-name", 1, "1", rpc.string_type(), true, false
  ).is_valid());
  stdio.println(rpc.message("Bad-Message", arr[]).is_valid());
  stdio.println(rpc.rpc_method(
    55, "Bad-Service", "Call", "test.call", "Req", "Res"
  ).is_valid());
  stdio.println(rpc.http_field_binding(
    55, "valid_field", "broken\"name", rpc.http_query_location()
  ).is_valid());

  // Wire numbers are immutable numeric identities, not caller-supplied
  // protobuf/MessagePack source tokens. Leading zeros and source injection
  // must be rejected before any emitter is invoked.
  stdio.println(rpc.field("safe", 1, "1", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("mismatch", 1, "2", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("zero_prefix", 1, "01", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("injection", 1, "1; injected", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("maximum", 536870911, "536870911", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("overflow", 536870912, "536870912", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.field("reserved_num", 19999, "19999", rpc.string_type(), true, false).is_valid());
  stdio.println(rpc.message("message", arr[]).is_valid());
  stdio.println(rpc.rpc_method(
    56, "service", "Call", "test.call", "Req", "Res"
  ).is_valid());

  // The safe entrypoint validates every top-level generator argument.
  stdio.println(rpc.generate_all_checked(
    rt borrow contracts, "https://example.test/schema/rpc", "example.api", "Example.Api"
  ).is_ok());
  stdio.println(rpc.generate_all_checked(
    rt borrow contracts, "https://example.test/x\"evil", "example.api", "Example.Api"
  ).is_err());
  stdio.println(rpc.generate_all_checked(
    rt borrow contracts, "https://example.test/schema/rpc", "example.api;evil", "Example.Api"
  ).is_err());
  stdio.println(rpc.generate_all_checked(
    rt borrow contracts, "https://example.test/schema/rpc", "example.api", "Example.Api\"evil"
  ).is_err());

  // HTTP header aliases must fold ASCII case before collision detection.
  let header_alias_builder = rpc.builder();
  header_alias_builder.add_http_field_binding(
    rpc.http_header_field(600, "first", "X-Trace")
  ).unwrap();
  stdio.println(header_alias_builder.add_http_field_binding(
    rpc.http_header_field(600, "second", "x-trace")
  ).is_err());
  stdio.println(header_alias_builder.http_field_binding_count());

  // An HTTP route cannot silently accept unbound placeholders.
  let missing_path_builder = rpc.builder();
  missing_path_builder.add_message(rpc.message("Req", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])).unwrap();
  missing_path_builder.add_message(rpc.message("Res", arr[
    rpc.field("ok", 1, "1", rpc.bool_type(), true, false)
  ])).unwrap();
  missing_path_builder.add_rpc_as_http(
    rpc.rpc_method(700, "Tests", "MissingPath", "tests.missing_path", "Req", "Res"),
    "GET", "/items/{id}", 700, 1
  ).unwrap();
  stdio.println(missing_path_builder.build().is_err());

  // Nor can a path binding claim an absent route placeholder.
  let extra_path_builder = rpc.builder();
  extra_path_builder.add_message(rpc.message("Req", arr[
    rpc.field("id", 1, "1", rpc.string_type(), true, false)
  ])).unwrap();
  extra_path_builder.add_message(rpc.message("Res", arr[
    rpc.field("ok", 1, "1", rpc.bool_type(), true, false)
  ])).unwrap();
  extra_path_builder.add_rpc_as_http(
    rpc.rpc_method(701, "Tests", "ExtraPath", "tests.extra_path", "Req", "Res"),
    "GET", "/items", 701, 1
  ).unwrap();
  extra_path_builder.add_http_field_binding(
    rpc.http_path_field(701, "id", "id")
  ).unwrap();
  stdio.println(extra_path_builder.build().is_err());

  // Generated TypeSpec models and interfaces share one namespace.
  let service_name_collision = rpc.builder();
  service_name_collision.add_message(rpc.message("Req", arr[])).unwrap();
  service_name_collision.add_message(rpc.message("Res", arr[])).unwrap();
  service_name_collision.add_rpc(
    rpc.rpc_method(800, "Req", "Call", "test.service_collision", "Req", "Res")
  ).unwrap();
  stdio.println(service_name_collision.build().is_err());

  let projection_name_collision = rpc.builder();
  projection_name_collision.add_message(rpc.message("Req", arr[])).unwrap();
  projection_name_collision.add_message(rpc.message("Res", arr[])).unwrap();
  projection_name_collision.add_message(rpc.message("A_B_HttpRequest", arr[])).unwrap();
  projection_name_collision.add_rpc_as_http(
    rpc.rpc_method(801, "A", "B", "test.projection_collision", "Req", "Res"),
    "GET", "/ping", 801, 1
  ).unwrap();
  stdio.println(projection_name_collision.build().is_err());

  let ambiguous_projection = rpc.builder();
  ambiguous_projection.add_message(rpc.message("Req", arr[])).unwrap();
  ambiguous_projection.add_message(rpc.message("Res", arr[])).unwrap();
  ambiguous_projection.add_rpc_as_http(
    rpc.rpc_method(802, "A_B", "C", "test.c", "Req", "Res"),
    "GET", "/c", 802, 1
  ).unwrap();
  ambiguous_projection.add_rpc_as_http(
    rpc.rpc_method(803, "A", "B_C", "test.b_c", "Req", "Res"),
    "GET", "/b-c", 803, 1
  ).unwrap();
  stdio.println(ambiguous_projection.build().is_err());

  // Budget validation is independent of identifier uniqueness: 64 unique
  // messages are admitted, while the 65th must fail without mutation.
  let cap_builder = rpc.builder();
  let String cap_name = "M";
  for (let int cap_index = 0; cap_index < 64; cap_index = cap_index + 1) {
    cap_builder.add_message(rpc.message(cap_name, arr[])).unwrap();
    cap_name = cap_name + "x";
  }
  stdio.println(cap_builder.message_count());
  stdio.println(cap_builder.add_message(rpc.message(cap_name, arr[])).is_err());
  stdio.println(cap_builder.message_count());

  // Invalid TypeSpec string literal routes must fail at contract build even
  // if the same malformed HTTP path was accepted at initial registration.
  let route_injection_builder = rpc.builder();
  route_injection_builder.add_message(rpc.message("Req", arr[])).unwrap();
  route_injection_builder.add_message(rpc.message("Res", arr[])).unwrap();
  route_injection_builder.add_rpc_as_http(
    rpc.rpc_method(810, "Tests", "RouteInjection", "tests.route_injection", "Req", "Res"),
    "GET", "/injected\\\"token", 810, 1
  ).unwrap();
  stdio.println(route_injection_builder.build().is_err());

  // Proto3 cannot encode an independently required repeated field.
  stdio.println(rpc.field(
    "invalid_presence", 1, "1", rpc.string_type(), true, true
  ).is_valid());

  return;
}
