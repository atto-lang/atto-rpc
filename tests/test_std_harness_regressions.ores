import class TestCase, TestSuite, TestOptions, TestOutcome, RunSummary from "ores.std/testing";
import fnc expect_true, expect_false, expect_equal_int, expect_equal_string, run_suite, require_success, fail from "ores.std/testing";
import module rpc from "../src/rpc.ores";
fnc reserved_protobuf_number_rejected(): TestOutcome {
  val reserved = rpc.field("id", 19000, "19000", rpc.int32_type(), true, false);
  return expect_false(reserved.is_valid(), "protobuf reserved field 19000 must be rejected");
}
fnc duplicate_message_number_rejected(): TestOutcome {
  val message = rpc.message("Duplicate", arr[
    rpc.field("a", 1, "1", rpc.string_type(), true, false),
    rpc.field("b", 1, "1", rpc.bool_type(), false, false)
  ]);
  return expect_false(message.is_valid(), "two message fields cannot share a wire number");
}
fnc unnamed_message_reference_denied(): TestOutcome {
  return expect_false(rpc.message_type("").is_valid(),
    "named RPC message references cannot use an empty name");
}
fnc zero_wire_field_number_is_invalid(): TestOutcome {
  val field_value = rpc.field("id", 0, "0", rpc.int32_type(), true, false);
  return expect_false(field_value.is_valid(),
    "wire field numbers start at one");
}

fnc duplicate_message_field_name_is_invalid(): TestOutcome {
  val message = rpc.message("Collision", arr[
    rpc.field("same", 1, "1", rpc.string_type(), true, false),
    rpc.field("same", 2, "2", rpc.bool_type(), false, false)
  ]);
  return expect_false(message.is_valid(),
    "different field numbers cannot make duplicate names valid");
}

fnc field_number_above_protobuf_max_is_rejected(): TestOutcome {
  val field_value = rpc.field("id", 536870912, "536870912", rpc.int32_type(), true, false);
  return expect_false(field_value.is_valid(),
    "protobuf field numbers must remain inside their 29-bit domain");
}

fnc last_reserved_protobuf_number_is_rejected(): TestOutcome {
  val field_value = rpc.field("id", 19999, "19999", rpc.int32_type(), true, false);
  return expect_false(field_value.is_valid(),
    "the inclusive upper endpoint of reserved field IDs must fail");
}

pub routine main(): void {
  val TestSuite suite = new TestSuite("rpc", arr[
    new TestCase("reserved_protobuf_number_rejected", reserved_protobuf_number_rejected, false, ""),
    new TestCase("duplicate_message_number_rejected", duplicate_message_number_rejected, false, ""),
    new TestCase("unnamed_message_reference_denied", unnamed_message_reference_denied, false, ""),
    new TestCase("zero_wire_field_number_is_invalid", zero_wire_field_number_is_invalid, false, ""),
    new TestCase("duplicate_message_field_name_is_invalid", duplicate_message_field_name_is_invalid, false, ""),
    new TestCase("field_number_above_protobuf_max_is_rejected", field_number_above_protobuf_max_is_rejected, false, ""),
    new TestCase("last_reserved_protobuf_number_is_rejected", last_reserved_protobuf_number_is_rejected, false, "")
  ]);
  val TestOptions options = new TestOptions("", false, true);
  val RunSummary summary = run_suite(rt borrow suite, rt borrow options);
  require_success(rt borrow summary);
  return;
}
